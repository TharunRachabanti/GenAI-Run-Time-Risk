# GenAI Runtime Risk Research Platform
# Environment Configuration

# 1. Provide your Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# 2. Configure the LLMs for the experiments
# PRIMARY_MODEL is used for the baseline and most experiments.
# SECONDARY_MODEL is used specifically for EXP-005 (Model Variation) and EXP-007.
PRIMARY_MODEL=gemini-1.5-flash
SECONDARY_MODEL=gemini-1.5-pro
