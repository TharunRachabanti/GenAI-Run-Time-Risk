# ============================================================
# GenAI Runtime Risk Research Platform
# Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# ---- LLM PROVIDER SELECTION --------------------------------
# Choose one of: openai, anthropic, google
GENAI_PROVIDER=openai
GENAI_MODEL_NAME=gpt-4o

# ---- API KEYS (Only fill the one you selected above) -------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-...
GOOGLE_API_KEY=AIzaSy...

# ---- DATABASE ----------------------------------------------
# By default, the system uses a local SQLite file.
# You do not need to change these unless using PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./genai_runtime_risk.db
DATABASE_SYNC_URL=sqlite:///./genai_runtime_risk.db
